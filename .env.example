# Copie para .env.local e preencha com os valores reais (nunca commitar .env.local).

# URL do projeto Supabase (self-hosted via Coolify)
NEXT_PUBLIC_SUPABASE_URL=

# Chave anônima (pública) do Supabase — segura para expor no cliente,
# a RLS do banco é quem decide o que cada usuário pode ver/alterar.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ATENÇÃO: chave de administrador, ignora RLS por completo. NUNCA prefixar
# com NEXT_PUBLIC_ (isso a exporia no bundle do navegador). Só usar em
# código server-only (src/lib/supabase/admin.ts) — nunca em Client Components.
SUPABASE_SERVICE_ROLE_KEY=
