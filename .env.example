# Copie para .env.local e preencha com os valores reais (nunca commitar .env.local).

# URL do projeto Supabase (self-hosted via Coolify)
NEXT_PUBLIC_SUPABASE_URL=

# Chave anônima (pública) do Supabase — segura para expor no cliente,
# a RLS do banco é quem decide o que cada usuário pode ver/alterar.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
